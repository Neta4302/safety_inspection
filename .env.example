# Copy this file to .env and fill in real values. Never commit .env itself —
# .gitignore already excludes it.

# Port the server listens on. Render sets this automatically; locally it defaults
# to 4173 if unset.
# PORT=4173

# Set to "true" ONLY when running behind a TLS-terminating proxy such as Render.
# It makes the app trust x-forwarded-proto and x-forwarded-for. Leave it unset
# locally: those headers can be forged by any client when no proxy is in front.
# TRUST_PROXY=true

# PostgreSQL connection string — not used yet. This is where it will go when the
# database migration happens after the ครั้งที่ 3 submission.
# Paste the value from Neon/Supabase here; it contains a password, so it must never
# appear in source files, screenshots, or the submitted archive.
# DATABASE_URL=postgresql://user:password@host/dbname
